<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Your Wake Word"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/mojo_primary"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Say your wake word 3 times. That is all MOJO needs."
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="24dp"/>

        <!-- Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 1 — TYPE YOUR WAKE WORD"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etWakeWord"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="e.g.  Mojo  /  Jarvis  /  Boss"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_card"
                android:paddingHorizontal="14dp"
                android:inputType="text"
                android:singleLine="true"/>

        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 2 — SAY IT 3 TIMES"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Say your word naturally. MOJO uses AI to generate many training variants from just 3 recordings."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvRecordStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 3"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/mojo_primary"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp"/>

            <ProgressBar
                android:id="@+id/progressRecord"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="3"
                android:progress="0"
                android:progressTint="@color/mojo_primary"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnRecord"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="&#x1F399; Record"
                android:textSize="16sp"/>

        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 3 — TRAIN"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOJO auto-generates 24 training samples from your 3 recordings and trains the model on your phone in ~10 seconds."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/btnTrain"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Train MOJO"
                android:textSize="15sp"
                android:enabled="false"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvTrainStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/mojo_accent"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"/>

    </LinearLayout>
</ScrollView>